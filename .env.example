# Infra (docker-compose defaults)
KAFKA_BROKERS=localhost:19092
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://arxiv:arxiv@localhost:5432/arxiv

# Topics
TOPIC_PAPERS_NEW=papers.new
TOPIC_PAPERS_CHUNKED=papers.chunked
TOPIC_PAPERS_FAILED=papers.failed

# Poller
ARXIV_CATEGORIES=cs.LG,cs.CV,cs.RO
ARXIV_POLL_INTERVAL_SECS=900
ARXIV_PAGE_SIZE=200
ARXIV_MAX_PAGES=10
ARXIV_MIN_REQUEST_INTERVAL_SECS=3
ARXIV_USER_AGENT=arxiv-ingest/0.1

# Inference (OpenAI-compatible). Local Ollama by default.
EMBEDDING_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
LLM_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
SUMMARY_ENABLED=true

RUST_LOG=info
